    "abstractPt": {
      "enabled": true,
      "text": "Este trabalho apresenta uma ferramenta que gera documentos acadêmicos formatados a partir de um modelo estruturado. O modelo separa conteúdo e formatação, permitindo aplicar perfis de norma configuráveis. Os resultados indicam redução do retrabalho de formatação e maior consistência entre os documentos produzidos.",
      "keywords": ["formatação", "documentos estruturados", "normalização"]
    },
    "abstractEn": {
      "enabled": true,
      "text": "This work presents a tool that generates formatted academic documents from a structured model. The model separates content from formatting, allowing configurable norm profiles to be applied.",
      "keywords": ["formatting", "structured documents", "standards"]
    },
    "lists": { "figures": true, "tables": true }
  },
