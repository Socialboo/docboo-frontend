server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index _shell.html;

    # Large documents/images are uploaded through the API; keep in sync with API limits.
    client_max_body_size 25m;

    location /api/ {
        # API_UPSTREAM is substituted by the nginx image (envsubst) at container start.
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback: TanStack Start (SPA mode) emits _shell.html.
    location / {
        try_files $uri $uri/ /_shell.html;
        add_header Cache-Control "no-cache";
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
}
