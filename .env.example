# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# Where /api is proxied to (the docboo-backend API).
# Default: the API published on the Docker host at port 5248 (Docker or `dotnet run`).
API_UPSTREAM=http://host.docker.internal:5248

# Published ports
WEB_PORT=8080
WEB_DEV_PORT=3000

# OpenAPI source for `bun run gen:api` (URL or file path).
# Default: http://localhost:5248/openapi/v1.json (the running API).
# OPENAPI_SOURCE=../docboo-backend/Backend/openapi/openapi.json
